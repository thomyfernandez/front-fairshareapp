{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:mock": "vite --mode mock",
    "prestart:mock": "npm run tokens:build",
    "mock:check": "node scripts/check-mock-contracts.mjs",
    "mock:check:java": "node scripts/check-mock-contracts.mjs --backend ../fairshareapp",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tokens:build": "node scripts/generate-theme.mjs",
    "tokens:check": "node scripts/generate-theme.mjs --check",
    "predev": "npm run tokens:build",
    "prebuild": "npm run tokens:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock:generate": "node scripts/generate-mock-data.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.1.2",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "vitest": "^5.0.3"
  }
}
